<div class="order-form mx-auto">
  <div class="form-floating mb-3">
    <input type="number" min="1" max="500" class="form-control {{#if fieldErrors.quantity}}is-invalid{{/if}}" id="admin-order-quantity" value="{{order.quantity}}" placeholder="Количество" name="quantity" required>
    <label for="admin-order-quantity">Количество</label>
    {{#if fieldErrors.quantity}}<div class="invalid-feedback">{{fieldErrors.quantity}}</div>{{/if}}
  </div>

  <div class="form-floating mb-3">
    <input type="number" step="0.01" min="1" max="1000000" class="form-control {{#if fieldErrors.price}}is-invalid{{/if}}" id="admin-order-price" value="{{order.price}}" placeholder="Стоимость" name="price" required>
    <label for="admin-order-price">Стоимость</label>
    {{#if fieldErrors.price}}<div class="invalid-feedback">{{fieldErrors.price}}</div>{{/if}}
  </div>

  <div class="form-floating mb-3">
    <input type="url" class="form-control {{#if fieldErrors.link}}is-invalid{{/if}}" id="admin-order-link" value="{{order.link}}" placeholder="Ссылка" name="link" data-order-link-input data-original-link="{{originalOrderLink}}" aria-describedby="admin-order-link-error" required>
    <label for="admin-order-link">Ссылка</label>
    <div class="invalid-feedback" id="admin-order-link-error" data-field-error="link">{{fieldErrors.link}}</div>
  </div>

  <div class="d-flex justify-content-end gap-2">
    <a href="/manageorders" class="btn btn-outline-secondary">Отмена</a>
    <button class="btn btn-primary" type="submit">Сохранить</button>
  </div>
</div>

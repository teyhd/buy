<div data-list-pagination>
  {{#if (or prevUrl nextUrl)}}
    <nav class="d-flex justify-content-center gap-2 mb-3" aria-label="Навигация по списку">
      {{#if prevUrl}}
        <a class="btn btn-outline-secondary" href="{{prevUrl}}">Предыдущая страница</a>
      {{/if}}
      {{#if nextUrl}}
        <a class="btn btn-outline-secondary" href="{{nextUrl}}" data-list-more data-next-url="{{nextBatchUrl}}">Загрузить ещё</a>
      {{/if}}
    </nav>
    <span class="visually-hidden" role="status" data-list-status></span>
  {{/if}}
</div>
{{#unless fragment}}
  {{#if nextUrl}}
    <script type="module" src="/javascript/list-pagination.js"></script>
  {{/if}}
{{/unless}}

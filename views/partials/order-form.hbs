<div class="order-form order-panel mx-auto">
  <div class="mb-3">
    <label class="form-label" for="order-good">Название</label>
    <input type="text" class="form-control {{#if fieldErrors.good}}is-invalid{{/if}}" id="order-good" value="{{order.good}}" placeholder="Название" name="good" required minlength="2" maxlength="255">
    {{#if fieldErrors.good}}<div class="invalid-feedback">{{fieldErrors.good}}</div>{{/if}}
  </div>

  <div class="row g-2">
    <div class="col-12 col-md-6">
      <div class="mb-3">
        <label class="form-label" for="order-quantity">Количество</label>
        <input type="number" min="1" max="500" class="form-control {{#if fieldErrors.quantity}}is-invalid{{/if}}" id="order-quantity" value="{{order.quantity}}" placeholder="Количество" name="quantity" required>
        {{#if fieldErrors.quantity}}<div class="invalid-feedback">{{fieldErrors.quantity}}</div>{{/if}}
      </div>
    </div>
    <div class="col-12 col-md-6">
      <div class="mb-3">
        <label class="form-label" for="order-price">Ориентировочная общая стоимость</label>
        <input type="number" step="0.01" min="1" max="1000000" class="form-control {{#if fieldErrors.price}}is-invalid{{/if}}" id="order-price" value="{{order.price}}" placeholder="Ориентировочная общая стоимость" name="price" required>
        {{#if fieldErrors.price}}<div class="invalid-feedback">{{fieldErrors.price}}</div>{{/if}}
      </div>
    </div>
  </div>

  <div class="mb-3">
    <label class="form-label" for="order-link">Ссылка</label>
    <input type="url" class="form-control {{#if fieldErrors.link}}is-invalid{{/if}}" id="order-link" value="{{order.link}}" placeholder="Ссылка" name="link" required>
    {{#if fieldErrors.link}}<div class="invalid-feedback">{{fieldErrors.link}}</div>{{/if}}
  </div>

  <div class="mb-3">
    <label class="form-label" for="order-comment">Комментарий к товару</label>
    <textarea class="form-control {{#if fieldErrors.comment}}is-invalid{{/if}}" id="order-comment" name="comment" rows="2" maxlength="1000">{{order.comment}}</textarea>
    <div class="form-text">Например: не срочно, для кафедры.</div>
    {{#if fieldErrors.comment}}<div class="invalid-feedback">{{fieldErrors.comment}}</div>{{/if}}
  </div>

  <div class="mb-3">
    <label class="form-label" for="order-arrival-date">Желаемая дата доставки</label>
    <input type="date" class="form-control {{#if fieldErrors.arrival_date}}is-invalid{{/if}}" id="order-arrival-date" value="{{formatDateInput order.arrival_date}}" placeholder="Желаемая дата доставки" name="arrival_date" required>
    {{#if fieldErrors.arrival_date}}<div class="invalid-feedback">{{fieldErrors.arrival_date}}</div>{{/if}}
  </div>

  <div class="order-form__actions">
    <a href="{{cancelUrl}}" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i> Отмена</a>
    <button class="btn btn-primary" type="submit"><i class="bi bi-check2"></i> Сохранить</button>
  </div>
</div>

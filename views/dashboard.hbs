<div class="page-header">
  {{> notice}}
  <div class="d-flex flex-column flex-md-row justify-content-between gap-3 align-items-md-center">
    <div>
      <h1>Заказчики</h1>
      <div class="text-muted">Найдено: {{total}}</div>
    </div>
  </div>

  <form class="row g-2 align-items-end mt-3" method="GET" action="/dashboard" novalidate>
    <div class="col-12 col-md-6">
      <label class="form-label" for="customers-q">Поиск</label>
      <input class="form-control" id="customers-q" type="search" placeholder="Имя, логин или SSO ID" name="q" value="{{filters.q}}">
    </div>
    <div class="col-12 col-md-auto d-flex gap-2">
      <button class="btn btn-outline-dark" type="submit">Найти</button>
      <a class="btn btn-outline-secondary" href="/dashboard">Сбросить</a>
    </div>
  </form>
</div>

{{#if hasRows}}
<div class="table-responsive">
  <table class="table table-bordered align-middle">
    <thead class="table-dark">
      <tr>
        <th scope="col">Заказчик</th>
        <th scope="col">Активные</th>
        <th scope="col">Закрытые</th>
        <th scope="col">Всего</th>
        <th scope="col">Сумма</th>
        <th scope="col" class="text-end">Действия</th>
      </tr>
    </thead>
    <tbody>
      {{#each rows}}
      <tr>
        <td>{{this.owner_label}}</td>
        <td>{{this.active_count}}</td>
        <td>{{this.closed_count}}</td>
        <td>{{this.total_count}}</td>
        <td>{{this.total_price_label}} руб.</td>
        <td class="text-end">
          <a href="{{this.owner_link}}" class="btn btn-light btn-sm"><i class="bi bi-eye"></i> Заказы</a>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
{{else}}
  {{#if hasFilters}}
    {{> empty-state title="Ничего не найдено" text="Измените поиск или сбросьте фильтры."}}
  {{else}}
    {{> empty-state title="Заказчиков пока нет" text="Список строится автоматически по оформленным заказам."}}
  {{/if}}
{{/if}}

{{> pagination}}

<div id="snackbar">{{alert}}</div>
<script src="/javascript/snackbar.js"></script>
<script>
  var message = "{{alert}}";
  if (!message) {
    message = new URL(window.location.href).searchParams.get('error');
  }
  if (message !== undefined && message !== null) {
    snackBAR(message);
  }
</script>

<div class="page-header">
  {{> notice}}
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/dashboard">Заказчики</a></li>
      <li class="breadcrumb-item active" aria-current="page">История заказчика</li>
    </ol>
  </nav>

  <div class="d-flex flex-column flex-md-row justify-content-between gap-3 align-items-md-center">
    <div>
      <h1>{{viewedUser.label}}</h1>
      <div class="text-muted">{{viewedUser.email}} · заказов: {{total}}</div>
    </div>
  </div>

  <form class="row g-2 align-items-end mt-3" method="GET" action="/dashboard/vieworder/{{ownerSource}}/{{viewedUser.id}}" novalidate>
    <div class="col-12 col-md-4">
      <label class="form-label" for="owner-scope">Период</label>
      <select class="form-select" id="owner-scope" name="scope">
        {{#each scopeOptions}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="col-12 col-md-auto d-flex gap-2">
      <button class="btn btn-outline-dark" type="submit">Показать</button>
      <a class="btn btn-outline-secondary" href="/dashboard/vieworder/{{ownerSource}}/{{viewedUser.id}}?scope=all">Все</a>
    </div>
  </form>
</div>

{{#if hasRows}}
<div class="table-responsive">
  <table class="table table-bordered align-middle">
    <thead class="table-dark">
      <tr>
        <th scope="col">Товар</th>
        <th scope="col">Количество</th>
        <th scope="col">Стоимость</th>
        <th scope="col">Ссылка</th>
        <th scope="col">Дата заказа</th>
        <th scope="col">Желаемая доставка</th>
        <th scope="col">Статус</th>
      </tr>
    </thead>
    <tbody>
      {{#each orders}}
      <tr>
        <td>{{this.good}}</td>
        <td>{{this.quantity}}</td>
        <td>{{this.price_label}} руб.</td>
        <td><a class="table-link" href="{{this.link}}" target="_blank" rel="noopener noreferrer">{{this.link_label}}</a></td>
        <td>{{formatDate this.creation_date}}</td>
        <td>{{formatDate this.arrival_date}}</td>
        <td>{{> status-badge}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
{{else}}
  {{> empty-state title="Заказов в этом разделе нет" text="Смените фильтр периода, чтобы посмотреть другую историю."}}
{{/if}}

{{> pagination}}

<div class="page-header">
  {{> notice}}
  <div class="d-flex flex-column flex-md-row justify-content-between gap-3 align-items-md-center">
    <div>
      <h1>Мои заказы</h1>
      <div class="text-muted">
        Найдено: {{total}} · всего: {{summary.total_count}} · активные: {{summary.active_count}} · закрытые: {{summary.closed_count}}
      </div>
    </div>
    <a href="/myorders/addorder" class="btn btn-primary">Добавить заказ</a>
  </div>

  <form class="row g-2 align-items-end mt-3" method="GET" action="/myorders" novalidate>
    <div class="col-12 col-md-5">
      <label class="form-label" for="myorders-q">Поиск</label>
      <input class="form-control" id="myorders-q" type="search" placeholder="Товар или ссылка" name="q" value="{{filters.q}}">
    </div>
    <div class="col-12 col-md-4">
      <label class="form-label" for="myorders-status">Статус</label>
      <select class="form-select" id="myorders-status" name="status">
        <option value="">Все статусы</option>
        {{#each statusOptions}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="col-12 col-md-auto d-flex gap-2">
      <button class="btn btn-outline-dark" type="submit">Найти</button>
      <a class="btn btn-outline-secondary" href="/myorders">Сбросить</a>
    </div>
  </form>
</div>

{{#if hasRows}}
<div class="table-responsive">
  <table class="table table-bordered align-middle">
    <thead class="table-dark">
      <tr>
        <th scope="col">Название</th>
        <th scope="col">Количество</th>
        <th scope="col">Стоимость</th>
        <th scope="col">Ссылка</th>
        <th scope="col">Дата заказа</th>
        <th scope="col">Желаемая доставка</th>
        <th scope="col">Статус</th>
        <th scope="col" class="text-end">Действия</th>
      </tr>
    </thead>
    <tbody>
      {{#each rows}}
      <tr>
        <td>
          <div>{{this.good}}</div>
          {{#if this.created_by_admin}}
            <div class="text-muted small">добавлено администратором</div>
          {{/if}}
        </td>
        <td>{{this.quantity}}</td>
        <td>{{this.price_label}} руб.</td>
        <td><a class="table-link" href="{{this.link}}" target="_blank" rel="noopener noreferrer">{{this.link_label}}</a></td>
        <td>{{formatDate this.creation_date}}</td>
        <td>{{formatDate this.arrival_date}}</td>
        <td>{{> status-badge}}</td>
        <td class="text-end table-actions">
          {{#if this.is_pending}}
            <a href="/myorders/editorder/{{this.id}}" class="btn btn-light btn-sm"><i class="bi bi-pencil"></i> Изменить</a>
            <form action="/myorders/{{this.id}}/cancel" method="POST" class="d-inline" onsubmit="return confirm('Отменить заказ?');">
              <button type="submit" class="btn btn-outline-secondary btn-sm">Отменить</button>
            </form>
          {{else}}
            <span class="text-muted">Недоступно</span>
          {{/if}}
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
{{else}}
  {{#if hasFilters}}
    {{> empty-state title="Ничего не найдено" text="Измените поиск или сбросьте фильтры."}}
  {{else}}
    {{> empty-state title="У вас пока нет заказов" text="Создайте первый заказ, когда понадобится закупка."}}
  {{/if}}
{{/if}}

{{> pagination}}

<div id="snackbar">{{alert}}</div>
<script src="/javascript/snackbar.js"></script>
<script>
  if ("{{alert}}") {
    var message = "{{alert}}";
    if (message !== undefined && message !== null) {
      snackBAR(message);
    }
  }
</script>

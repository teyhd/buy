<div class="page-header text-center">
  <h2>Обновить данные заказа</h2>
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb justify-content-center">
      <li class="breadcrumb-item"><a href="/manageorders">Активные заказы</a></li>
      <li class="breadcrumb-item active" aria-current="page">Изменение заказа</li>
    </ol>
  </nav>
</div>

{{> notice}}

<form action="/manageorders/editorderadmin/{{order.id}}" class="row g-3 needs-validation" method="POST" novalidate>
  {{> edit-order-admin}}
</form>

<div id="snackbar">{{alert}}</div>
<script src="/javascript/snackbar.js"></script>
<script>
  if ("{{alert}}") {
    var message = "{{alert}}";
    if (message !== undefined && message !== null) {
      snackBAR(message);
    }
  }
</script>

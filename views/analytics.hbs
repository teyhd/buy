<div class="page-header">
  <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-center">
    <div>
      <h1>Аналитика заказов</h1>
      <div class="text-muted">Бюджет, факт расходов и выгрузка для учёта по текущей выборке.</div>
    </div>
    <a class="btn btn-outline-dark" href="{{csvUrl}}"><i class="bi bi-download"></i> Скачать CSV</a>
  </div>

  <form class="analytics-filter row g-2 align-items-end mt-3" method="GET" action="/analytics" novalidate>
    <div class="col-12 col-lg-4">
      <label class="form-label" for="analytics-q">Поиск</label>
      <input class="form-control" id="analytics-q" type="search" name="q" value="{{filters.q}}" placeholder="Товар, заказчик или ссылка">
    </div>
    <div class="col-12 col-md-6 col-lg-3">
      <label class="form-label" for="analytics-scope">Сценарий отчёта</label>
      <select class="form-select" id="analytics-scope" name="scope">
        {{#each scopeOptions}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="col-12 col-md-6 col-lg-3">
      <label class="form-label" for="analytics-status">Статус</label>
      <select class="form-select" id="analytics-status" name="status">
        <option value="">Все по сценарию</option>
        {{#each statusOptions}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="col-12 col-md-6 col-lg-2">
      <label class="form-label" for="analytics-date-field">Дата учёта</label>
      <select class="form-select" id="analytics-date-field" name="date_field">
        {{#each dateFieldOptions}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="col-12 col-md-6 col-lg-2">
      <label class="form-label" for="analytics-date-from">С даты</label>
      <input class="form-control" id="analytics-date-from" type="date" name="date_from" value="{{filters.date_from}}">
    </div>
    <div class="col-12 col-md-6 col-lg-2">
      <label class="form-label" for="analytics-date-to">По дату</label>
      <input class="form-control" id="analytics-date-to" type="date" name="date_to" value="{{filters.date_to}}">
    </div>
    <div class="col-12 col-md-6 col-lg-2">
      <label class="form-label" for="analytics-owner-type">Источник</label>
      <select class="form-select" id="analytics-owner-type" name="owner_type">
        {{#each ownerTypeOptions}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="col-12 col-md-6 col-lg-2">
      <label class="form-label" for="analytics-price-from">Сумма от</label>
      <input class="form-control" id="analytics-price-from" type="number" min="0" step="0.01" name="price_from" value="{{filters.price_from}}">
    </div>
    <div class="col-12 col-md-6 col-lg-2">
      <label class="form-label" for="analytics-price-to">Сумма до</label>
      <input class="form-control" id="analytics-price-to" type="number" min="0" step="0.01" name="price_to" value="{{filters.price_to}}">
    </div>
    <div class="col-12 col-lg-auto d-flex gap-2">
      <button class="btn btn-outline-dark" type="submit">Сформировать</button>
      <a class="btn btn-outline-secondary" href="/analytics">Сбросить</a>
    </div>
  </form>
</div>

<div class="analytics-grid mb-4">
  <div class="analytics-card">
    <div class="analytics-card__label">К планированию</div>
    <div class="analytics-card__value">{{summary.budget_amount_label}} руб.</div>
    <div class="analytics-card__hint">Все выбранные заказы без отменённых</div>
  </div>
  <div class="analytics-card">
    <div class="analytics-card__label">В работе</div>
    <div class="analytics-card__value">{{summary.active_amount_label}} руб.</div>
    <div class="analytics-card__hint">Заявки до закрытия</div>
  </div>
  <div class="analytics-card">
    <div class="analytics-card__label">Факт расходов</div>
    <div class="analytics-card__value">{{summary.fact_amount_label}} руб.</div>
    <div class="analytics-card__hint">Статус “Получен”</div>
  </div>
  <div class="analytics-card">
    <div class="analytics-card__label">На рассмотрении</div>
    <div class="analytics-card__value">{{summary.pending_amount_label}} руб.</div>
    <div class="analytics-card__hint">Потенциальная нагрузка</div>
  </div>
  <div class="analytics-card">
    <div class="analytics-card__label">Всего заявок</div>
    <div class="analytics-card__value">{{summary.total_orders}}</div>
    <div class="analytics-card__hint">Средняя сумма: {{summary.avg_amount_label}} руб.</div>
  </div>
  <div class="analytics-card analytics-card--muted">
    <div class="analytics-card__label">Отменено</div>
    <div class="analytics-card__value">{{summary.cancelled_amount_label}} руб.</div>
    <div class="analytics-card__hint">Не включать в бюджет</div>
  </div>
</div>

{{#if hasRows}}
<div class="row g-4">
  <div class="col-12 col-xl-6">
    <section class="report-section">
      <h2>По месяцам</h2>
      <div class="table-responsive">
        <table class="table table-bordered align-middle">
          <thead class="table-dark">
            <tr>
              <th>Период</th>
              <th>Заявок</th>
              <th>Сумма</th>
              <th>Доля</th>
            </tr>
          </thead>
          <tbody>
            {{#each monthRows}}
            <tr>
              <td>{{period}}</td>
              <td>{{orders_count}}</td>
              <td>{{amount_label}} руб.</td>
              <td>{{share_label}}%</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <div class="col-12 col-xl-6">
    <section class="report-section">
      <h2>По статусам</h2>
      <div class="table-responsive">
        <table class="table table-bordered align-middle">
          <thead class="table-dark">
            <tr>
              <th>Статус</th>
              <th>Заявок</th>
              <th>Сумма</th>
              <th>Доля</th>
            </tr>
          </thead>
          <tbody>
            {{#each statusRows}}
            <tr>
              <td>{{> status-badge}}</td>
              <td>{{orders_count}}</td>
              <td>{{amount_label}} руб.</td>
              <td>{{share_label}}%</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <div class="col-12">
    <section class="report-section">
      <h2>Заказчики с наибольшей суммой</h2>
      <div class="table-responsive">
        <table class="table table-bordered align-middle">
          <thead class="table-dark">
            <tr>
              <th>Заказчик</th>
              <th>Источник</th>
              <th>Заявок</th>
              <th>Всего</th>
              <th>В работе</th>
              <th>Факт</th>
              <th>Доля</th>
            </tr>
          </thead>
          <tbody>
            {{#each ownerRows}}
            <tr>
              <td><a href="{{owner_link}}">{{owner_label}}</a></td>
              <td><span class="badge text-bg-light">{{source_label}}</span></td>
              <td>{{orders_count}}</td>
              <td>{{amount_label}} руб.</td>
              <td>{{active_amount_label}} руб.</td>
              <td>{{fact_amount_label}} руб.</td>
              <td>{{share_label}}%</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <div class="col-12 col-xl-6">
    <section class="report-section">
      <h2>Товары по сумме</h2>
      <div class="table-responsive">
        <table class="table table-bordered align-middle">
          <thead class="table-dark">
            <tr>
              <th>Товар</th>
              <th>Заявок</th>
              <th>Кол-во</th>
              <th>Сумма</th>
            </tr>
          </thead>
          <tbody>
            {{#each productRows}}
            <tr>
              <td>{{good}}</td>
              <td>{{orders_count}}</td>
              <td>{{quantity_count}}</td>
              <td>{{amount_label}} руб.</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <div class="col-12 col-xl-6">
    <section class="report-section">
      <h2>Последние строки отчёта</h2>
      <div class="table-responsive">
        <table class="table table-bordered align-middle">
          <thead class="table-dark">
            <tr>
              <th>Дата</th>
              <th>Автор</th>
              <th>Товар</th>
              <th>Сумма</th>
              <th>Статус</th>
            </tr>
          </thead>
          <tbody>
            {{#each recentOrders}}
            <tr>
              <td>{{formatDate creation_date}}</td>
              <td>{{owner_label}}</td>
              <td>{{good}}</td>
              <td>{{price_label}} руб.</td>
              <td>{{> status-badge}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</div>
{{else}}
  {{#if hasFilters}}
    {{> empty-state title="По фильтрам ничего не найдено" text="Измените период, сценарий отчёта или поиск."}}
  {{else}}
    {{> empty-state title="Данных для аналитики пока нет" text="Отчёт появится после оформления первых заказов."}}
  {{/if}}
{{/if}}

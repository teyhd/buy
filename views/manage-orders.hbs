<div class="page-header">
  {{> notice}}
  <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-center">
    <div>
      <h1>Активные заказы</h1>
      <div class="text-muted">Найдено: {{total}} · сумма: {{price_count}} руб.</div>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <a href="/myorders/addorder" class="btn btn-primary">Добавить свой заказ</a>
      <a href="/manageorders/addorder" class="btn btn-outline-primary">Добавить за пользователя</a>
    </div>
  </div>

  <form class="row g-2 align-items-end mt-3" method="GET" action="/manageorders" novalidate>
    <div class="col-12 col-lg-5">
      <label class="form-label" for="manage-q">Поиск</label>
      <input class="form-control" id="manage-q" type="search" name="q" value="{{filters.q}}" placeholder="Товар, автор или ссылка">
    </div>
    <div class="col-12 col-md-4 col-lg-3">
      <label class="form-label" for="manage-status">Статус</label>
      <select class="form-select" id="manage-status" name="status">
        <option value="">Все активные</option>
        {{#each statusOptions}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="col-12 col-md-auto d-flex gap-2">
      <button class="btn btn-outline-dark" type="submit">Найти</button>
      <a class="btn btn-outline-secondary" href="/manageorders">Сбросить</a>
    </div>
  </form>
</div>

{{#if hasRows}}
<div class="table-responsive">
  <table class="table table-bordered align-middle">
    <thead class="table-dark">
      <tr>
        <th scope="col">Автор</th>
        <th scope="col">Товар</th>
        <th scope="col">Количество</th>
        <th scope="col">Стоимость</th>
        <th scope="col">Ссылка</th>
        <th scope="col">Дата заказа</th>
        <th scope="col">Желаемая доставка</th>
        <th scope="col">Статус</th>
        <th scope="col" class="text-end">Действия</th>
      </tr>
    </thead>
    <tbody>
      {{#each orders}}
      <tr>
        <td>
          <a href="/dashboard/vieworder/{{this.owner_type}}/{{this.owner_ref}}?scope=active">{{this.owner_label}}</a>
          {{#if this.created_by_admin}}
            <div class="text-muted small">создал: {{this.created_by_label}}</div>
          {{/if}}
        </td>
        <td>{{> expandable-text text=this.good}}</td>
        <td>{{this.quantity}}</td>
        <td>{{this.price_label}} руб.</td>
        <td><a class="table-link" href="{{this.link}}" target="_blank" rel="noopener noreferrer">{{this.link_label}}</a></td>
        <td>{{formatDate this.creation_date}}</td>
        <td>{{formatDate this.arrival_date}}</td>
        <td>
          <form action="/manageorders/{{this.id}}/status" method="POST" class="status-form">
            <input type="hidden" name="return_to" value="{{../currentUrl}}">
            <select class="form-select form-select-sm" name="status" aria-label="Статус заказа">
              {{#each this.status_options}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
            <button type="submit" class="btn btn-light btn-sm">
              <i class="bi bi-floppy" aria-hidden="true"></i>
              <span>Сохранить</span>
            </button>
          </form>
        </td>
        <td class="text-end">
          <a href="/manageorders/editorderadmin/{{this.id}}" class="btn btn-light btn-sm"><i class="bi bi-pencil"></i> Изменить</a>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
{{else}}
  {{#if hasFilters}}
    {{> empty-state title="Ничего не найдено" text="Измените поиск или сбросьте фильтры."}}
  {{else}}
    {{> empty-state title="Активных заказов нет" text="Новые заявки появятся здесь после оформления пользователями."}}
  {{/if}}
{{/if}}

{{> pagination}}

<div id="snackbar">{{alert}}</div>
<script src="/javascript/snackbar.js"></script>
<script>
  if ("{{alert}}") {
    var message = "{{alert}}";
    if (message !== undefined && message !== null) {
      snackBAR(message);
    }
  }
</script>

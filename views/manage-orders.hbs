<div class="page-header">
  {{> notice}}
  <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-center">
    <div>
      <h1>Активные заказы</h1>
      <div class="text-muted">Найдено: {{total}} · сумма: {{price_count}} руб.</div>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <a href="/myorders/addorder" class="btn btn-primary">Добавить свой заказ</a>
      <a href="/manageorders/addorder" class="btn btn-outline-primary">Добавить за пользователя</a>
    </div>
  </div>

  <form class="row g-2 align-items-end mt-3" method="GET" action="/manageorders" novalidate>
    <div class="col-12 col-lg-5">
      <label class="form-label" for="manage-q">Поиск</label>
      <input class="form-control" id="manage-q" type="search" name="q" value="{{filters.q}}" placeholder="Товар, автор или ссылка">
    </div>
    <div class="col-12 col-md-4 col-lg-3">
      <label class="form-label" for="manage-status">Статус</label>
      <select class="form-select" id="manage-status" name="status">
        <option value="">Все активные</option>
        {{#each statusOptions}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="col-12 col-md-auto d-flex gap-2">
      <button class="btn btn-outline-dark" type="submit">Найти</button>
      <a class="btn btn-outline-secondary" href="/manageorders">Сбросить</a>
    </div>
  </form>
</div>

<div class="alert manage-orders-alert d-none" data-manage-alert role="alert"></div>

{{#if hasRows}}
<div class="table-responsive">
  <table class="table table-bordered align-middle">
    <thead class="table-dark">
      <tr>
        <th scope="col">Автор</th>
        <th scope="col">Товар</th>
        <th scope="col">Количество</th>
        <th scope="col">Стоимость</th>
        <th scope="col">Ссылка</th>
        <th scope="col">Дата заказа</th>
        <th scope="col">Желаемая доставка</th>
        <th scope="col">Статус</th>
        <th scope="col" class="text-end">Действия</th>
      </tr>
    </thead>
    <tbody>
      {{#each orders}}
      <tr data-order-row="{{this.id}}">
        <td>
          <a href="/dashboard/vieworder/{{this.owner_type}}/{{this.owner_ref}}?scope=active">{{this.owner_label}}</a>
          {{#if this.created_by_admin}}
            <div class="text-muted small">создал: {{this.created_by_label}}</div>
          {{/if}}
        </td>
        <td>{{> expandable-text text=this.good}}</td>
        <td data-order-quantity>{{this.quantity}}</td>
        <td data-order-price>{{this.price_label}} руб.</td>
        <td data-order-link-cell><a class="table-link" href="{{this.link}}" target="_blank" rel="noopener noreferrer" data-order-link>{{this.link_label}}</a></td>
        <td>{{formatDate this.creation_date}}</td>
        <td>{{formatDate this.arrival_date}}</td>
        <td>
          <form action="/manageorders/{{this.id}}/status" method="POST" class="status-form" data-status-control>
            <input type="hidden" name="return_to" value="{{../currentUrl}}">
            <select
              class="form-select form-select-sm"
              name="status"
              aria-label="Статус заказа"
              data-status-select
              data-order-id="{{this.id}}"
              data-url="/manageorders/{{this.id}}/status"
              data-return-to="{{../currentUrl}}"
              data-original-status="{{this.status}}">
              {{#each this.status_options}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
            <span class="inline-save-state" data-status-state aria-live="polite"></span>
            <noscript>
              <button type="submit" class="btn btn-light btn-sm">Сохранить</button>
            </noscript>
          </form>
        </td>
        <td class="text-end">
          <button class="btn btn-light btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#edit-order-{{this.id}}">
            <i class="bi bi-pencil"></i> Изменить
          </button>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>

{{#each orders}}
<div class="modal fade" id="edit-order-{{this.id}}" tabindex="-1" aria-labelledby="edit-order-{{this.id}}-title" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form action="/manageorders/editorderadmin/{{this.id}}" method="POST" class="js-admin-edit-form" data-order-id="{{this.id}}" novalidate>
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="edit-order-{{this.id}}-title">Изменить заказ</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-danger d-none" data-modal-error role="alert"></div>

          <div class="mb-3">
            <label class="form-label" for="edit-order-{{this.id}}-quantity">Количество</label>
            <input class="form-control" id="edit-order-{{this.id}}-quantity" name="quantity" type="number" min="1" max="500" value="{{this.quantity}}" required>
            <div class="invalid-feedback" data-field-error="quantity"></div>
          </div>

          <div class="mb-3">
            <label class="form-label" for="edit-order-{{this.id}}-price">Ориентировочная общая стоимость</label>
            <input class="form-control" id="edit-order-{{this.id}}-price" name="price" type="text" inputmode="decimal" value="{{this.price}}" required>
            <div class="invalid-feedback" data-field-error="price"></div>
          </div>

          <div class="mb-0">
            <label class="form-label" for="edit-order-{{this.id}}-link">Ссылка</label>
            <input class="form-control" id="edit-order-{{this.id}}-link" name="link" type="url" value="{{this.link}}" required>
            <div class="invalid-feedback" data-field-error="link"></div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отмена</button>
          <button type="submit" class="btn btn-primary" data-submit-button>Сохранить</button>
        </div>
      </form>
    </div>
  </div>
</div>
{{/each}}
{{else}}
  {{#if hasFilters}}
    {{> empty-state title="Ничего не найдено" text="Измените поиск или сбросьте фильтры."}}
  {{else}}
    {{> empty-state title="Активных заказов нет" text="Новые заявки появятся здесь после оформления пользователями."}}
  {{/if}}
{{/if}}

{{> pagination}}

<div id="snackbar">{{alert}}</div>
<script src="/javascript/snackbar.js"></script>
<script>
  if ("{{alert}}") {
    var message = "{{alert}}";
    if (message !== undefined && message !== null) {
      snackBAR(message);
    }
  }
</script>
<script src="/javascript/manage-orders.js"></script>
